{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "vite --mode api",
    "dev:lan": "vite --mode lan --host",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run --passWithNoTests",
    "api:types": "npx --yes openapi-typescript@7.13.0 http://localhost:5080/openapi/v1.json -o src/shared/backend/api/schema.ts"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@supabase/supabase-js": "^2.117.0",
    "barcode-detector": "^3.2.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.3"
  }
}
