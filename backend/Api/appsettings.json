{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [
      "https://pet-gest.vercel.app",
      "http://localhost:5183"
    ],
    "AllowedOriginPatterns": [
      "^https://pet-gest-[a-z0-9-]+-itallo2ls-projects\\.vercel\\.app$"
    ]
  },
  "Jwt": {
    "Issuer": "petgest-api",
    "Audience": "petgest-app"
  },
  "Auth": {
    "RequireConfirmedEmail": false,
    "FrontendBaseUrl": "http://localhost:5183"
  },
  "RateLimit": {
    "Auth": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    }
  }
}
