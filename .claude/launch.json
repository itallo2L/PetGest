{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "frontend"
      ],
      "port": 5183
    },
    {
      "name": "frontend-dev-api",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:api",
        "--prefix",
        "frontend"
      ],
      "port": 5183
    },
    {
      "name": "backend-api",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": [
        "run",
        "--project",
        "backend/Api"
      ],
      "port": 5080
    },
    {
      "name": "frontend-preview",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "preview",
        "--prefix",
        "frontend",
        "--",
        "--port",
        "4173",
        "--strictPort"
      ],
      "port": 4173
    }
  ]
}
